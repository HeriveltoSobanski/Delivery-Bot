{
  "name": "delivery-bot",
  "version": "1.0.0",
  "description": "DeliveryBot é um projeto desenvolvido para a aula de **Desenvolvimento Web Mobile IV**, com foco no gerenciamento de pedidos de restaurante e validação de entregas pelo CEP usando a API ViaCEP.",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "migrate": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create -j sql",
    "migrate:test": "node-pg-migrate up --envPath .env.test",
    "pretest": "npm run migrate:test",
    "test": "cross-env NODE_ENV=test jest --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeriveltoSobanski/Delivery-Bot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/HeriveltoSobanski/Delivery-Bot/issues"
  },
  "homepage": "https://github.com/HeriveltoSobanski/Delivery-Bot#readme",
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "node-fetch": "^2.7.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.2.2"
  }
}
